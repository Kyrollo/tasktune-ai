# Shared secret required for every route except GET /api/health.
# Use the same generated value as AgentServices:ServiceApiKey in the ASP.NET Core API.
TASKTUNE_SERVICE_API_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Configure only model-provider credentials required by your selected agents.
GROQ_API_KEY=
OPENAI_API_KEY=
