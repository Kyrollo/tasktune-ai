{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "Issuer": "TaskTuneAPI",
    "Audience": "TaskTuneFrontend",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Outbox": {
      "Enabled": false,
      "MaxAttempts": 5,
      "LeaseSeconds": 180,
      "MaxPendingPerTenant": 1000,
      "MaxRecipientsPerApproval": 250,
      "QueueAgeWarningMinutes": 15
    }
  }
}
