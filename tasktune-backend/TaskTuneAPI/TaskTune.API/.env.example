# Copy values into your secret store or local user-secrets. Never commit real values.
ConnectionStrings__DefaultConnection=Server=localhost;Database=TaskTuneAIDatabase;Trusted_Connection=True;TrustServerCertificate=False
JWT_SECRET=replace-with-at-least-32-random-bytes
JwtSettings__Issuer=TaskTuneAPI
JwtSettings__Audience=TaskTuneFrontend
JwtSettings__AccessTokenExpirationMinutes=15
JwtSettings__RefreshTokenExpirationDays=7
Cors__AllowedOrigins__0=http://localhost:5173
Registration__AllowCompanySelfService=false

# All agent processes and the API must receive the same secret through a secret store.
AGENT_SERVICE_TOKEN=replace-with-a-different-random-secret
AGENT_CHATBOT_URL=http://127.0.0.1:8001
AGENT_GUIDANCE_URL=http://127.0.0.1:5050
AGENT_PROGRESS_URL=http://127.0.0.1:8003
AGENT_REPORT_URL=http://127.0.0.1:8004
AGENT_EMAIL_URL=http://127.0.0.1:8005
