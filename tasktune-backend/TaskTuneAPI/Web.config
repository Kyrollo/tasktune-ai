<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="configBuilders" type="System.Configuration.ConfigurationBuildersSection, System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" restartOnExternalChanges="false" requirePermission="false" />
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <configBuilders>
    <builders>
      <add name="Secrets" userSecretsId="7a0e9589-41c3-434d-aa4f-98ad53682219" type="Microsoft.Configuration.ConfigurationBuilders.UserSecretsConfigBuilder, Microsoft.Configuration.ConfigurationBuilders.UserSecrets, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
    </builders>
  </configBuilders>
  <connectionStrings>
    <add name="TaskTuneDb" connectionString="Data Source=KERO;Initial Catalog=TaskTuneAIDatabase;Persist Security Info=True;User ID=sa;Password=12345678;Encrypt=False;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="owin:AppStartup" value="TaskTuneAPI.Startup" />
    <add key="JwtSecretKey" value="jEHTH1xI1Qqh9U32iFrAVMg3qZkiQOTBeePluOYgt6bLqeCW8W3h72F8FZZSzlLs" />
    <add key="JwtIssuer" value="TaskTuneAPI" />
    <add key="JwtAudience" value="TaskTuneFrontend" />
    <add key="JwtExpirationMinutes" value="60" />
    <add key="JwtRefreshExpirationDays" value="7" />
    <add key="UploadPath" value="~/Uploads/" />
    <!-- AI Agents — FastAPI servers (one entry per agent) -->
    <add key="PythonExe" value="python" />
    <add key="AgentWorkDir" value="D:\Personal\Courses\Agentic AI - NTI\Final Project\files\tasktune-agents" />

    <!-- Agent: Task Guidance  (uvicorn agent2_task_guidance.server:app port 5050) -->
    <add key="AgentTaskGuidance" value="agent2_task_guidance" />
    <add key="AgentTaskGuidanceUrl" value="http://localhost:5050/api/guidance" />

    <!-- Agent: Progress Tracking  (uvicorn agent3_progress_tracking.main:app port 8003) -->
    <add key="AgentProgressTracking" value="agent3_progress_tracking" />
    <add key="AgentProgressTrackingUrl" value="http://localhost:8003/api/ai/progress-tracking" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
  </system.web>
